# Copy this file to .env and fill in your values.

# Model folder to use (relative to the project, or an absolute path).
# Put best_info.json from training inside it so the tuned threshold is used.
MODEL_DIR=model_v3

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/VulneraAI

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
# How long a login stays valid (hours)
JWT_EXPIRES_HOURS=24

# Gemini (optional, for AI explanations)
GEMINI_API_KEY=paste your Gemini API key here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120


# ==========================================
# VulneraAI - Environment Configuration
# ==========================================

# ---------- SMTP EMAIL CONFIGURATION ----------
# Gmail address used to send OTP verification emails.
SMTP_EMAIL=your-email@gmail.com

# Gmail App Password (16-character password).
# Do NOT use your normal Gmail account password.
SMTP_PASSWORD=your-gmail-app-password

# SMTP server configuration (Gmail).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587


# ---------- SESSION CONFIGURATION ----------
# Session expiration time in hours.
SESSION_EXPIRES_HOURS=24

# Set false for local HTTP development.
# Set true when deployed with HTTPS.
SESSION_COOKIE_SECURE=false

# Cookie policy: Lax, Strict, or None.
SESSION_COOKIE_SAMESITE=Lax


# ---------- CORS ----------
# Comma-separated list of allowed frontend origins.
# Default is local development only. Set your real domain in production:
#   CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=http://localhost:3000


# ---------- OTP SECURITY ----------
# Random secret key used for OTP-related security.
# Generate your own unique key using Python.
OTP_SECRET_KEY=generate-your-own-secret-key


# ---------- FRONTEND API CONFIGURATION ----------
# Backend API URL used by the React/Vite frontend.
VITE_API_URL=http://localhost:5000
